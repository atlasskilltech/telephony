{
  "name": "admission-crm-telephony",
  "version": "1.0.0",
  "description": "AI-Powered Admission CRM & Cloud Telephony System for university admission teams",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/queues/worker.js",
    "worker:dev": "nodemon src/queues/worker.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --minify"
  },
  "keywords": [
    "crm",
    "admission",
    "telephony",
    "ai",
    "whisper",
    "gpt",
    "education"
  ],
  "author": "Atlas University Admission Tech Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.682.0",
    "@aws-sdk/s3-request-presigner": "^3.682.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.21.0",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "nanoid": "^3.3.7",
    "openai": "^4.68.4",
    "rate-limit-redis": "^4.2.0",
    "sequelize": "^6.37.4",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.2",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14"
  },
  "_moduleAliases": {
    "@root": ".",
    "@src": "src",
    "@config": "src/config",
    "@models": "src/models",
    "@services": "src/services",
    "@repositories": "src/repositories",
    "@controllers": "src/controllers",
    "@middlewares": "src/middlewares",
    "@utils": "src/utils"
  }
}
