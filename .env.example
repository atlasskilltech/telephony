# ===========================================================================
# ATLAS Telephony & Cloud Telephony System - Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ===========================================================================

# ---- App ----
NODE_ENV=development
APP_NAME="ATLAS Telephony"
APP_URL=http://localhost:3000
PORT=3000
# Comma-separated list of allowed CORS origins (mobile/web)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database (MySQL 8) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admission_crm
DB_USER=crm_user
DB_PASSWORD=change_me
DB_DIALECT=mysql
# Prefix applied to every table name (lets the schema share a database).
# Default is telephony_ ; set to empty to disable prefixing.
DB_TABLE_PREFIX=telephony_
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_LOGGING=false

# ---- Redis (cache, sessions, BullMQ) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=replace_with_session_secret
BCRYPT_ROUNDS=12

# ---- AI (OpenAI) ----
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
AI_ENABLED=true

# ---- Storage (AWS S3 with local fallback) ----
STORAGE_DRIVER=local
# local | s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=admission-crm-recordings
LOCAL_STORAGE_PATH=./storage

# ---- Google Sign-in (OAuth) ----
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://telephony.atlasskilltech.app/google/callback
# Restrict sign-in to this Google Workspace domain (empty = no restriction).
GOOGLE_HOSTED_DOMAIN=atlasuniversity.edu.in
# Mobile app OAuth client id(s) accepted as the ID-token audience for
# POST /auth/google (comma-separated; Android + iOS client ids).
GOOGLE_MOBILE_CLIENT_IDS=

# ---- Cloud Telephony ----
# Active provider: exotel | knowlarity | myoperator | ozonetel
TELEPHONY_PROVIDER=exotel
TELEPHONY_WEBHOOK_SECRET=replace_with_webhook_secret
# Exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com

# ---- WhatsApp / Email (optional integrations) ----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Admissions <admissions@example.edu>"

# ---- NoPaperForms (NPF) lead CRM integration ----
# After each call is analysed, the lead is looked up by mobile and a Dynamic
# Activity is pushed carrying the public transcript URL + call scores.
# Leave the keys blank to run the integration in stub mode (logged + skipped).
NPF_ENABLED=true
NPF_BASE_URL=https://api.nopaperforms.io/lead/v1
NPF_SECRET_KEY=
NPF_ACCESS_KEY=
# Dynamic Activity config id (provided by NPF for the call-activity schema).
NPF_ACTIVITY_CONFIG_ID=m6lAGd4b9NqZIpD2IKZzf6OLeXMJ2B7Q
NPF_TIMEZONE=Asia/Kolkata
# Public base URL for the transcript link posted to NPF (cf_call_transcript_url).
# MUST be a real https domain — NPF's gateway 403s a raw IP:port URL in the body
# (e.g. http://13.205.226.151:4444/...). Defaults to APP_URL when unset.
NPF_PUBLIC_BASE_URL=https://telephony.atlasskilltech.app

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
