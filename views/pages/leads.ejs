<div x-data="leadsPage()" x-init="init()">
  <!-- Toolbar -->
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <div class="relative flex-1 min-w-[200px]">
      <input x-model="filters.search" @input.debounce.400ms="filters.page=1; load()" placeholder="Search name, phone, email…"
        class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none focus:border-indigo-400" />
      <svg class="w-5 h-5 absolute left-3 top-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <select x-model="filters.pipeline_stage" @change="filters.page=1; load()"
      class="px-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none">
      <option value="">All stages</option>
      <% ['new_lead','contacted','interested','qualified','application_started','application_submitted','offer_issued','admission_confirmed','enrollment_completed'].forEach(function(s){ %>
        <option value="<%= s %>"><%= s.replace(/_/g,' ') %></option>
      <% }); %>
    </select>
    <button @click="openImport()" class="px-4 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium">Import CSV</button>
    <button @click="showCreate = true" class="px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium">+ New Lead</button>
  </div>

  <!-- Assign bar (single or bulk) — shown to users who can assign -->
  <div x-show="assignees.length" class="flex flex-wrap items-center gap-3 mb-4 p-3 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
    <span class="text-sm text-slate-500" x-text="selectedCount() + ' selected'"></span>
    <select x-model="assignTo" class="px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none text-sm">
      <option value="">Assign to counselor…</option>
      <template x-for="a in assignees" :key="a.id"><option :value="a.id" x-text="a.name"></option></template>
    </select>
    <button @click="assignSelected()" :disabled="!assignTo || !selectedCount() || assigning"
      class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed">
      <span x-show="!assigning" x-text="'Assign ' + selectedCount() + ' lead(s)'"></span>
      <span x-show="assigning">Assigning…</span>
    </button>
  </div>

  <!-- Table -->
  <div class="glass rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-left">
          <tr>
            <th class="px-4 py-3 font-medium w-10" x-show="assignees.length"><input type="checkbox" :checked="allSelected()" @change="toggleAll($event)" /></th>
            <th class="px-4 py-3 font-medium">Lead</th>
            <th class="px-4 py-3 font-medium">Course</th>
            <th class="px-4 py-3 font-medium">Stage</th>
            <th class="px-4 py-3 font-medium">Counselor</th>
            <th class="px-4 py-3 font-medium">AI Interest</th>
            <th class="px-4 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <template x-for="lead in leads" :key="lead.id">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3" x-show="assignees.length"><input type="checkbox" :checked="!!selected[lead.id]" @change="toggle(lead.id)" /></td>
              <td class="px-4 py-3">
                <div class="font-medium" x-text="lead.student ? (lead.student.first_name + ' ' + (lead.student.last_name||'')) : '—'"></div>
                <div class="text-xs text-slate-500" x-text="lead.student?.phone"></div>
              </td>
              <td class="px-4 py-3" x-text="lead.course || '—'"></td>
              <td class="px-4 py-3"><span class="px-2 py-1 rounded-md text-xs bg-indigo-50 text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300" x-text="(lead.pipeline_stage||'').replace(/_/g,' ')"></span></td>
              <td class="px-4 py-3" x-text="lead.counselor?.name || 'Unassigned'"></td>
              <td class="px-4 py-3">
                <span x-show="lead.ai_interest_score" class="font-medium" x-text="(lead.ai_interest_score||'') + '%'"></span>
                <span x-show="!lead.ai_interest_score" class="text-slate-400">—</span>
              </td>
              <td class="px-4 py-3 text-right">
                <button @click="call(lead)" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs">Call</button>
              </td>
            </tr>
          </template>
          <tr x-show="!loading && leads.length === 0"><td colspan="7" class="px-4 py-10 text-center text-slate-500">No leads found</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-slate-100 dark:border-slate-800 text-sm">
      <span class="text-slate-500" x-text="`Page ${meta.page||1} of ${meta.totalPages||1} · ${meta.total||0} leads`"></span>
      <div class="flex gap-2">
        <button @click="filters.page = Math.max(1,(meta.page||1)-1); load()" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700">Prev</button>
        <button @click="filters.page = (meta.page||1)+1; load()" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700">Next</button>
      </div>
    </div>
  </div>

  <!-- Create modal -->
  <div x-show="showCreate" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" @click.self="showCreate=false">
    <div class="glass bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 w-full max-w-md p-6">
      <h3 class="text-lg font-semibold mb-4">New Lead</h3>
      <div class="space-y-3">
        <input x-model="form.first_name" placeholder="First name *" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <input x-model="form.phone" placeholder="Phone *" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <input x-model="form.email" placeholder="Email" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <input x-model="form.course" placeholder="Course" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <input x-model="form.city" placeholder="City" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
      </div>
      <div class="flex justify-end gap-2 mt-5">
        <button @click="showCreate=false" class="px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700">Cancel</button>
        <button @click="create()" class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white">Create</button>
      </div>
    </div>
  </div>

  <!-- Import modal -->
  <div x-show="imp.show" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" @click.self="imp.show=false">
    <div class="glass bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 w-full max-w-2xl p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">Import leads from CSV / Excel</h3>
        <a href="/public/sample-leads.csv" download class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">Download sample CSV</a>
      </div>

      <!-- File picker -->
      <label class="block">
        <span class="text-sm text-slate-500">Choose a .csv, .xls or .xlsx file</span>
        <input type="file" accept=".csv,.xls,.xlsx" @change="onImportFile($event)"
          class="mt-2 block w-full text-sm file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-indigo-600 file:text-white hover:file:bg-indigo-700" />
      </label>

      <p x-show="imp.loading" class="text-sm text-slate-500 mt-4">Working…</p>
      <p x-show="imp.error" x-text="imp.error" class="text-sm text-rose-500 mt-4"></p>

      <!-- Preview (before commit) -->
      <template x-if="imp.preview && !imp.report">
        <div class="mt-4">
          <p class="text-sm mb-2">
            <span x-text="imp.preview.totalRows"></span> rows detected.
            Columns mapped: <span class="text-slate-500" x-text="Object.entries(imp.mapping).map(([h,f]) => h+' → '+f).join(', ') || 'none — check your headers'"></span>
          </p>
          <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-lg max-h-64">
            <table class="w-full text-xs">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-left sticky top-0">
                <tr>
                  <th class="px-3 py-2">#</th>
                  <th class="px-3 py-2">Name</th>
                  <th class="px-3 py-2">Phone</th>
                  <th class="px-3 py-2">Course</th>
                  <th class="px-3 py-2">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <template x-for="r in imp.preview.sample" :key="r.rowNumber">
                  <tr>
                    <td class="px-3 py-2" x-text="r.rowNumber"></td>
                    <td class="px-3 py-2" x-text="((r.data.first_name||'')+' '+(r.data.last_name||'')).trim() || '—'"></td>
                    <td class="px-3 py-2" x-text="r.data.phone || '—'"></td>
                    <td class="px-3 py-2" x-text="r.data.course || '—'"></td>
                    <td class="px-3 py-2">
                      <span x-show="r.valid && !r.isDuplicate" class="text-emerald-600">OK</span>
                      <span x-show="r.isDuplicate" class="text-amber-600">Duplicate</span>
                      <span x-show="!r.valid" class="text-rose-500" x-text="r.errors.join('; ')"></span>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
          <label class="flex items-center gap-2 mt-3 text-sm">
            <input type="checkbox" x-model="imp.skipDuplicates" class="rounded" />
            Skip rows whose phone already exists
          </label>
        </div>
      </template>

      <!-- Result report (after commit) -->
      <template x-if="imp.report">
        <div class="mt-4 grid grid-cols-4 gap-2 text-center">
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800"><div class="text-lg font-semibold" x-text="imp.report.total"></div><div class="text-xs text-slate-500">Total</div></div>
          <div class="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10"><div class="text-lg font-semibold text-emerald-600" x-text="imp.report.imported"></div><div class="text-xs text-slate-500">Imported</div></div>
          <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-500/10"><div class="text-lg font-semibold text-amber-600" x-text="imp.report.skipped"></div><div class="text-xs text-slate-500">Skipped</div></div>
          <div class="p-3 rounded-lg bg-rose-50 dark:bg-rose-500/10"><div class="text-lg font-semibold text-rose-600" x-text="imp.report.failed"></div><div class="text-xs text-slate-500">Failed</div></div>
        </div>
      </template>

      <div class="flex justify-end gap-2 mt-5">
        <button @click="imp.show=false" class="px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700" x-text="imp.report ? 'Close' : 'Cancel'"></button>
        <button x-show="imp.preview && !imp.report" @click="runImport()" :disabled="imp.loading"
          class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white disabled:opacity-50">Import <span x-text="imp.preview ? imp.preview.totalRows : ''"></span> rows</button>
      </div>
    </div>
  </div>
</div>
