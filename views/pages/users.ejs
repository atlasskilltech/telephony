<div x-data="usersPage()" x-init="init()">
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <div class="relative flex-1 min-w-[200px]">
      <input x-model="search" @input.debounce.400ms="page=1; load()" placeholder="Search name or email…"
        class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none focus:border-indigo-400" />
      <svg class="w-5 h-5 absolute left-3 top-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <button @click="openCreate()" class="px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium">+ New User</button>
  </div>

  <div class="glass rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-left text-xs uppercase tracking-wide">
          <tr>
            <th class="px-4 py-3 font-medium">Name</th>
            <th class="px-4 py-3 font-medium">Email</th>
            <th class="px-4 py-3 font-medium">Role</th>
            <th class="px-4 py-3 font-medium">Status</th>
            <th class="px-4 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <template x-for="u in users" :key="u.id">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3">
                <div class="font-medium" x-text="u.name"></div>
                <div class="text-xs text-slate-400" x-show="u.phone" x-text="u.phone"></div>
              </td>
              <td class="px-4 py-3" x-text="u.email"></td>
              <td class="px-4 py-3" x-text="u.role ? u.role.name : '—'"></td>
              <td class="px-4 py-3">
                <span class="px-2 py-1 rounded-md text-xs capitalize"
                  :class="u.status==='active' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10' : 'bg-slate-100 text-slate-500 dark:bg-slate-800'"
                  x-text="u.status"></span>
              </td>
              <td class="px-4 py-3 text-right">
                <button x-show="u.status==='active'" @click="deactivate(u)"
                  class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs hover:bg-slate-100 dark:hover:bg-slate-800">Deactivate</button>
                <button x-show="u.status!=='active'" @click="reactivate(u)"
                  class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs hover:bg-slate-100 dark:hover:bg-slate-800">Reactivate</button>
              </td>
            </tr>
          </template>
          <tr x-show="loading"><td colspan="5" class="px-4 py-12 text-center text-slate-500">Loading…</td></tr>
          <tr x-show="!loading && users.length===0"><td colspan="5" class="px-4 py-12 text-center text-slate-500">No users found</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-slate-100 dark:border-slate-800 text-sm">
      <span class="text-slate-500" x-text="`Page ${meta.page||1} of ${meta.totalPages||1} · ${meta.total||0} users`"></span>
      <div class="flex gap-2">
        <button @click="prev()" :disabled="(meta.page||1)<=1" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 disabled:opacity-40">Prev</button>
        <button @click="next()" :disabled="(meta.page||1)>=(meta.totalPages||1)" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 disabled:opacity-40">Next</button>
      </div>
    </div>
  </div>

  <!-- Create modal -->
  <div x-show="showCreate" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" @click.self="showCreate=false">
    <div class="glass bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 w-full max-w-md p-6">
      <h3 class="text-lg font-semibold mb-4">New user</h3>
      <p x-show="error" x-text="error" class="mb-3 text-sm text-rose-500"></p>
      <div class="space-y-3">
        <input x-model="form.name" placeholder="Full name *" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <input x-model="form.email" type="email" placeholder="Email * (Google sign-in)" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <input x-model="form.phone" placeholder="Phone" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
        <select x-model="form.role_slug" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none">
          <option value="">Select role *</option>
          <template x-for="r in roles" :key="r.id"><option :value="r.slug" x-text="r.name"></option></template>
        </select>
        <input x-model="form.agent_extension" placeholder="Agent extension (optional)" class="w-full px-4 py-2.5 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 outline-none" />
      </div>
      <div class="flex justify-end gap-2 mt-5">
        <button @click="showCreate=false" class="px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700">Cancel</button>
        <button @click="create()" :disabled="saving" class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white disabled:opacity-50">Create</button>
      </div>
      <p class="text-xs text-slate-500 mt-4">The user signs in with Google using this email — no password needed.</p>
    </div>
  </div>
</div>
<script>
  window.usersPage = function () {
    return {
      users: [], roles: [], meta: {}, page: 1, loading: true,
      search: '', showCreate: false, saving: false, error: '',
      form: { name: '', email: '', phone: '', role_slug: '', agent_extension: '' },
      async init() {
        await Promise.all([this.load(), this.loadRoles()]);
      },
      async load() {
        this.loading = true;
        const q = new URLSearchParams({ page: this.page, limit: 20 });
        if (this.search) q.set('search', this.search);
        const res = await api.get(`/api/v1/users?${q.toString()}`);
        this.users = res.data || [];
        this.meta = res.meta || {};
        this.loading = false;
      },
      async loadRoles() {
        try { this.roles = (await api.get('/api/v1/users/roles')).data || []; } catch (e) { this.roles = []; }
      },
      prev() { if ((this.meta.page || 1) > 1) { this.page = this.meta.page - 1; this.load(); } },
      next() { if ((this.meta.page || 1) < (this.meta.totalPages || 1)) { this.page = this.meta.page + 1; this.load(); } },
      openCreate() {
        this.error = '';
        this.form = { name: '', email: '', phone: '', role_slug: '', agent_extension: '' };
        this.showCreate = true;
      },
      async create() {
        this.error = '';
        if (!this.form.name || !this.form.email || !this.form.role_slug) {
          this.error = 'Name, email and role are required'; return;
        }
        this.saving = true;
        try {
          await api.post('/api/v1/users', this.form);
          this.showCreate = false;
          this.page = 1;
          await this.load();
        } catch (e) { this.error = e.message; } finally { this.saving = false; }
      },
      async deactivate(u) {
        if (!confirm(`Deactivate ${u.name}? They will no longer be able to sign in.`)) return;
        try { await api.del(`/api/v1/users/${u.id}`); await this.load(); } catch (e) { alert(e.message); }
      },
      async reactivate(u) {
        try { await api.put(`/api/v1/users/${u.id}`, { status: 'active' }); await this.load(); } catch (e) { alert(e.message); }
      },
    };
  };
</script>
