<div x-data="callsPage()" x-init="init()">
  <!-- NoPaperForms not configured: the manual "Post" action will be skipped.
       Driven by the live /npf-status check, with the precise reason. -->
  <div x-show="npfChecked && !npfEnabled" x-cloak class="mb-4 px-4 py-3 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm dark:bg-amber-500/10 dark:border-amber-500/30 dark:text-amber-300">
    <div class="flex items-start justify-between gap-3">
      <div>
        <span class="font-medium">NoPaperForms posting is not enabled.</span>
        <span x-text="npfStatusMessage()"></span>
      </div>
      <button x-show="isSuperAdmin" type="button" @click="showNpfConfig=!showNpfConfig"
        class="shrink-0 px-3 py-1.5 rounded-lg bg-amber-600 text-white text-xs font-medium cursor-pointer hover:bg-amber-700">
        Configure
      </button>
    </div>
    <!-- Super Admin: enter keys here; stored in the DB and used immediately (no restart). -->
    <div x-show="isSuperAdmin && showNpfConfig" x-cloak class="mt-3 pt-3 border-t border-amber-200 dark:border-amber-500/30 grid sm:grid-cols-2 gap-2">
      <input x-model="npfForm.secret_key" type="password" placeholder="Secret key"
        class="px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-amber-200 dark:border-amber-500/30 outline-none text-slate-800 dark:text-slate-100" />
      <input x-model="npfForm.access_key" type="password" placeholder="Access key"
        class="px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-amber-200 dark:border-amber-500/30 outline-none text-slate-800 dark:text-slate-100" />
      <input x-model="npfForm.activity_config_id" placeholder="Activity config id (optional)"
        class="px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-amber-200 dark:border-amber-500/30 outline-none text-slate-800 dark:text-slate-100 sm:col-span-2" />
      <div class="sm:col-span-2 flex items-center gap-2">
        <button type="button" @click="saveNpfConfig()" :disabled="savingNpf"
          class="px-4 py-2 rounded-lg bg-emerald-600 text-white text-xs font-medium cursor-pointer hover:bg-emerald-700 disabled:opacity-50"
          x-text="savingNpf ? 'Saving…' : 'Save & enable'"></button>
        <span class="text-xs text-amber-700 dark:text-amber-300">Keys are stored securely in the database and used right away.</span>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap items-end gap-3 mb-4">
    <div class="relative flex-1 min-w-[200px]">
      <input x-model="filters.search" @input.debounce.400ms="apply()" placeholder="Search lead name or number…"
        class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none focus:border-indigo-400" />
      <svg class="w-5 h-5 absolute left-3 top-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <select x-model="filters.range" @change="onRangeChange()"
      class="px-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none">
      <option value="today">Today</option>
      <option value="yesterday">Yesterday</option>
      <option value="7d">Last 7 days</option>
      <option value="30d">Last 30 days</option>
      <option value="custom">Custom…</option>
    </select>
    <template x-if="filters.range==='custom'">
      <div class="flex items-center gap-2">
        <input type="date" x-model="filters.from" @change="apply()" class="px-3 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none" />
        <span class="text-slate-400">–</span>
        <input type="date" x-model="filters.to" @change="apply()" class="px-3 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none" />
      </div>
    </template>
    <select x-show="agents.length" x-model="filters.agentId" @change="apply()"
      class="px-4 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 outline-none">
      <option value="">All agents</option>
      <template x-for="a in agents" :key="a.id"><option :value="a.id" x-text="a.name"></option></template>
    </select>
  </div>

  <div class="glass rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-left text-xs uppercase tracking-wide">
          <tr>
            <th class="px-4 py-3 font-medium">When</th>
            <th class="px-4 py-3 font-medium">Lead</th>
            <th class="px-4 py-3 font-medium">Agent</th>
            <th class="px-4 py-3 font-medium">Direction</th>
            <th class="px-4 py-3 font-medium">Status</th>
            <th class="px-4 py-3 font-medium">Duration</th>
            <th class="px-4 py-3 font-medium">AI</th>
            <th class="px-4 py-3 font-medium text-right">Recording</th>
          </tr>
        </thead>
        <template x-for="c in calls" :key="c.id">
          <tbody class="border-t border-slate-100 dark:border-slate-800">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 whitespace-nowrap" x-text="fmt.date(c.started_at)"></td>
              <td class="px-4 py-3">
                <div class="font-medium" x-text="c.lead?.student?.first_name || c.to_number"></div>
                <div class="text-xs text-slate-400" x-show="c.lead?.student?.first_name" x-text="c.to_number"></div>
              </td>
              <td class="px-4 py-3" x-text="c.agent?.name || '—'"></td>
              <td class="px-4 py-3 capitalize">
                <span class="inline-flex items-center gap-1 text-slate-600 dark:text-slate-300">
                  <span x-text="c.direction==='inbound' ? '↙' : '↗'"></span><span x-text="c.direction"></span>
                </span>
              </td>
              <td class="px-4 py-3">
                <span class="px-2 py-1 rounded-md text-xs capitalize"
                  :class="c.is_missed ? 'bg-rose-50 text-rose-600 dark:bg-rose-500/10' : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10'"
                  x-text="c.is_missed ? 'missed' : c.status"></span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap" x-text="fmt.duration(c.talk_time_seconds)"></td>
              <td class="px-4 py-3">
                <span x-show="retrying[c.id]" class="inline-flex items-center gap-1.5 text-xs text-slate-500">
                  <svg class="animate-spin w-3.5 h-3.5 text-indigo-500" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                  </svg>
                  processing…
                </span>
                <button x-show="!retrying[c.id] && c.analysis && c.analysis.status==='completed'" @click="openReport(c)"
                  class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-xs hover:bg-slate-100 dark:hover:bg-slate-800"
                  :class="c.analysis && c.analysis.sentiment==='positive' ? 'text-emerald-600' : (c.analysis && c.analysis.sentiment==='negative' ? 'text-rose-600' : 'text-slate-500')">
                  <span class="font-medium" x-text="Math.round(c.analysis ? (c.analysis.call_quality_score||c.analysis.agent_score||c.analysis.interest_score||0) : 0)"></span>
                  <span x-text="'· ' + (c.analysis ? c.analysis.sentiment : '')"></span>
                  <span class="underline opacity-70">report</span>
                </button>
                <span x-show="!retrying[c.id] && c.is_missed && (!c.analysis || c.analysis.status!=='completed')" class="text-slate-400 text-xs" title="No AI for missed calls">—</span>
                <span x-show="!retrying[c.id] && !c.is_missed && (!c.analysis || (c.analysis.status!=='completed' && c.analysis.status!=='failed'))" class="text-slate-400 text-xs">pending</span>
                <span x-show="!retrying[c.id] && !c.is_missed && c.analysis && c.analysis.status==='failed'" class="text-rose-500 text-xs">failed</span>
                <button type="button" x-show="!retrying[c.id] && c.recording" @click="retry(c)"
                  class="ml-2 px-2 py-0.5 rounded-md border border-slate-200 dark:border-slate-700 text-xs cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800">Retry</button>
                <button type="button" x-show="!retrying[c.id] && c.analysis && c.analysis.status==='completed'" @click="postNpf(c)" :disabled="posting[c.id]"
                  :title="npfEnabled ? 'Push transcript URL + scores to NoPaperForms' : 'NoPaperForms is not configured — set NPF keys to enable'"
                  class="ml-1 px-2 py-0.5 rounded-md text-white text-xs font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                  :class="npfEnabled ? 'bg-indigo-600 hover:bg-indigo-700' : 'bg-slate-400 hover:bg-slate-500'"
                  x-text="posting[c.id] ? 'Posting…' : 'Post'"></button>
                <div x-show="c.meta && c.meta.npf" class="text-[11px] mt-1" :class="npfColor(c)" x-text="npfLabel(c)"></div>
              </td>
              <td class="px-4 py-3 text-right">
                <button x-show="c.recording" @click="play(c)"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors"
                  :class="playingId===c.id ? 'bg-indigo-600 border-indigo-600 text-white' : 'border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800'">
                  <span x-text="playingId===c.id ? '❚❚' : '▶'"></span>
                  <span x-text="playingId===c.id ? 'Stop' : 'Play'"></span>
                </button>
                <span x-show="!c.recording" class="text-slate-400 text-xs">—</span>
              </td>
            </tr>
            <template x-if="playingId===c.id">
              <tr>
                <td colspan="8" class="px-4 pb-3 bg-slate-50/70 dark:bg-slate-800/30">
                  <audio controls autoplay class="w-full h-9" :src="audioUrl"></audio>
                </td>
              </tr>
            </template>
          </tbody>
        </template>
        <tbody x-show="loading">
          <tr><td colspan="8" class="px-4 py-12 text-center text-slate-500">Loading…</td></tr>
        </tbody>
        <tbody x-show="!loading && calls.length===0">
          <tr><td colspan="8" class="px-4 py-12 text-center text-slate-500">No calls yet</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-slate-100 dark:border-slate-800 text-sm">
      <span class="text-slate-500" x-text="`Page ${meta.page||1} of ${meta.totalPages||1} · ${meta.total||0} calls`"></span>
      <div class="flex gap-2">
        <button @click="prev()" :disabled="(meta.page||1)<=1"
          class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-100 dark:hover:bg-slate-800">Prev</button>
        <button @click="next()" :disabled="(meta.page||1)>=(meta.totalPages||1)"
          class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-100 dark:hover:bg-slate-800">Next</button>
      </div>
    </div>
  </div>

  <%- include('../partials/callReport') %>
</div>
<script>
  window.__NPF_ENABLED__ = <%- npfEnabled ? 'true' : 'false' %>;
  window.__IS_SUPER_ADMIN__ = <%- isSuperAdmin ? 'true' : 'false' %>;
  window.callsPage = function () {
    const startOfDay = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
    const endOfDay = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate(), 23, 59, 59, 999);

    return {
      ...window.callReportMixin(),
      calls: [], loading: true, audioUrl: '', playingId: null,
      meta: {}, page: 1, limit: 20,
      filters: { range: 'today', from: '', to: '', agentId: '', search: '' },
      agents: [],
      retrying: {},
      posting: {},
      npfEnabled: window.__NPF_ENABLED__ === true,
      npfChecked: false,
      npfStatus: {},
      isSuperAdmin: window.__IS_SUPER_ADMIN__ === true,
      showNpfConfig: false,
      savingNpf: false,
      npfForm: { secret_key: '', access_key: '', activity_config_id: '' },
      async init() {
        await this.load();
        this.loadAgents();
        this.loadNpfStatus();
      },
      async loadNpfStatus() {
        try {
          const res = await api.get('/api/v1/calls/npf-status');
          this.npfStatus = res.data || {};
          this.npfEnabled = !!this.npfStatus.enabled;
        } catch (e) {
          this.npfStatus = {};
        } finally {
          this.npfChecked = true;
        }
      },
      npfStatusMessage() {
        const s = this.npfStatus || {};
        const fix = this.isSuperAdmin ? ' Click Configure to enter the keys here.' : ' Ask an admin to configure the NoPaperForms keys.';
        if (s.flagEnabled === false) return 'It is disabled in settings.' + fix;
        if (s.hasSecretKey === false && s.hasAccessKey === false) return 'No secret/access keys are set.' + fix;
        if (s.hasSecretKey === false) return 'The secret key is missing.' + fix;
        if (s.hasAccessKey === false) return 'The access key is missing.' + fix;
        return 'Keys are incomplete.' + fix;
      },
      async saveNpfConfig() {
        if (!this.npfForm.secret_key && !this.npfForm.access_key && !this.npfForm.activity_config_id) {
          alert('Enter the secret key and access key first.'); return;
        }
        this.savingNpf = true;
        try {
          const res = await api.put('/api/v1/calls/npf-config', { ...this.npfForm, enabled: true });
          this.npfStatus = res.data || {};
          this.npfEnabled = !!this.npfStatus.enabled;
          this.npfForm = { secret_key: '', access_key: '', activity_config_id: '' };
          if (this.npfEnabled) { this.showNpfConfig = false; alert('NoPaperForms is now enabled ✓'); }
          else alert('Saved, but still not enabled — make sure both keys were entered.');
        } catch (e) {
          alert(e.message);
        } finally {
          this.savingNpf = false;
        }
      },
      computeRange() {
        const now = new Date();
        switch (this.filters.range) {
          case 'yesterday': {
            const y = new Date(now); y.setDate(y.getDate() - 1);
            return { from: startOfDay(y), to: endOfDay(y) };
          }
          case '7d': {
            const f = new Date(now); f.setDate(f.getDate() - 6);
            return { from: startOfDay(f), to: now };
          }
          case '30d': {
            const f = new Date(now); f.setDate(f.getDate() - 29);
            return { from: startOfDay(f), to: now };
          }
          case 'custom':
            return {
              from: this.filters.from ? new Date(`${this.filters.from}T00:00:00`) : null,
              to: this.filters.to ? new Date(`${this.filters.to}T23:59:59`) : null,
            };
          default:
            return { from: startOfDay(now), to: now };
        }
      },
      onRangeChange() { if (this.filters.range !== 'custom') this.apply(); },
      apply() { this.page = 1; this.load(); },
      async load() {
        this.loading = true;
        this.playingId = null;
        const { from, to } = this.computeRange();
        const q = new URLSearchParams({ page: this.page, limit: this.limit });
        if (from) q.set('from', from.toISOString());
        if (to) q.set('to', to.toISOString());
        if (this.filters.agentId) q.set('agent_id', this.filters.agentId);
        if (this.filters.search) q.set('search', this.filters.search);
        const res = await api.get(`/api/v1/calls?${q.toString()}`);
        this.calls = res.data || [];
        this.meta = res.meta || {};
        this.loading = false;
      },
      async loadAgents() {
        try { this.agents = (await api.get('/api/v1/calls/agents')).data || []; } catch (e) { this.agents = []; }
      },
      prev() {
        if ((this.meta.page || 1) <= 1) return;
        this.page = (this.meta.page || 1) - 1;
        this.load();
      },
      next() {
        if ((this.meta.page || 1) >= (this.meta.totalPages || 1)) return;
        this.page = (this.meta.page || 1) + 1;
        this.load();
      },
      async play(c) {
        if (this.playingId === c.id) { this.playingId = null; this.audioUrl = ''; return; }
        try {
          const res = await api.get(`/api/v1/calls/${c.id}/recording-url`);
          this.audioUrl = res.data.url;
          this.playingId = c.id;
        } catch (e) { alert(e.message); }
      },
      async retry(c) {
        this.retrying[c.id] = true;
        try {
          await api.post(`/api/v1/calls/${c.id}/retry-transcription`);
          setTimeout(async () => {
            try { await this.init(); } finally { this.retrying[c.id] = false; }
          }, 6000);
        } catch (e) {
          this.retrying[c.id] = false;
          alert(e.message);
        }
      },
      // ---- NoPaperForms manual post + status ----
      npfReason(reason) {
        return ({
          stub_mode: 'NoPaperForms keys are not configured (stub mode)',
          no_mobile: 'no usable mobile number on this call',
          lead_not_found: 'no matching lead found in NoPaperForms for this number',
          error: 'NoPaperForms returned an error',
          timeout: 'NoPaperForms did not respond in time (still finishing in the background — refresh to see the result)',
        })[reason] || reason || 'skipped';
      },
      async postNpf(c) {
        this.posting[c.id] = true;
        try {
          const res = await api.post(`/api/v1/calls/${c.id}/npf-sync`);
          const { result, npf } = res.data || {};
          if (npf) c.meta = { ...(c.meta || {}), npf };   // reflect persisted state on the row
          const r = result || {};
          if (r.activityId) alert(`Posted to NoPaperForms ✓\nActivity id: ${r.activityId}`);
          else if (r.skipped) alert(`Not posted — ${this.npfReason(r.reason)}.`);
          else alert('NoPaperForms sync triggered.');
        } catch (e) {
          alert(e.message);
        } finally {
          this.posting[c.id] = false;
        }
      },
      npfLabel(c) {
        const n = c.meta && c.meta.npf;
        if (!n) return '';
        if (n.status === 'synced') return `NPF ✓ ${n.action || 'sent'}${n.activityId ? ' #' + n.activityId : ''}`;
        if (n.status === 'failed') return `NPF failed${n.lastErrorStatus ? ' (HTTP ' + n.lastErrorStatus + ')' : ''}`;
        if (n.status === 'skipped') return `NPF skipped: ${this.npfReason(n.reason)}`;
        return 'NPF: pending';
      },
      npfColor(c) {
        const s = c.meta && c.meta.npf && c.meta.npf.status;
        return s === 'synced' ? 'text-emerald-600'
          : s === 'failed' ? 'text-rose-500'
          : s === 'skipped' ? 'text-amber-600' : 'text-slate-400';
      },
    };
  };
</script>
