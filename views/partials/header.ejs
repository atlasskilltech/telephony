<header class="h-16 flex items-center justify-between gap-4 px-4 sm:px-6 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-20">
  <div>
    <h1 class="text-lg font-semibold tracking-tight"><%= title %></h1>
  </div>
  <div class="flex items-center gap-3" x-data="{ open: false }">
    <!-- Theme toggle -->
    <button @click="dark = !dark" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800" title="Toggle theme">
      <svg x-show="dark" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.71-.71M6.34 6.34l-.7-.7m12.72 0l-.7.7M6.34 17.66l-.71.71M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <svg x-show="!dark" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
    </button>

    <!-- Notifications -->
    <div class="relative" x-data="notifBell()" x-init="init()">
      <button @click="open = !open" class="relative p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span x-show="unread > 0" x-text="unread" class="absolute -top-0.5 -right-0.5 bg-rose-500 text-white text-[10px] min-w-[18px] h-[18px] flex items-center justify-center rounded-full px-1"></span>
      </button>
      <div x-show="open" @click.outside="open = false" x-cloak class="absolute right-0 mt-2 w-80 glass rounded-xl border border-slate-200 dark:border-slate-800 shadow-xl p-2 max-h-96 overflow-y-auto">
        <template x-for="n in items" :key="n.id">
          <div class="p-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
            <p class="text-sm font-medium" x-text="n.title"></p>
            <p class="text-xs text-slate-500" x-text="n.body"></p>
          </div>
        </template>
        <p x-show="items.length === 0" class="text-sm text-slate-500 p-3">No notifications</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-sm font-semibold"><%= user.name.charAt(0) %></div>
      <div class="hidden sm:block leading-tight">
        <p class="text-sm font-medium"><%= user.name %></p>
        <p class="text-xs text-slate-500"><%= user.role ? user.role.name : '' %></p>
      </div>
    </div>
  </div>
</header>
