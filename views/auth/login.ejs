<div class="min-h-screen flex items-center justify-center relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-900 via-slate-950 to-purple-900"></div>
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-500/30 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/30 rounded-full blur-3xl"></div>

  <div class="relative glass rounded-2xl shadow-2xl w-full max-w-md p-8 mx-4">
    <div class="flex items-center gap-3 mb-8">
      <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg">A</div>
      <div>
        <h1 class="text-xl font-semibold">ATLAS Telephony</h1>
        <p class="text-xs text-slate-400">AI-Powered Telephony Platform</p>
      </div>
    </div>

    <% if (error) { %>
      <div class="mb-4 px-4 py-3 rounded-lg bg-rose-500/15 border border-rose-500/30 text-rose-200 text-sm"><%= error %></div>
    <% } %>

    <p class="text-sm text-slate-300 mb-5">Sign in with your organisation Google account to continue.</p>

    <a href="/google"
      class="w-full inline-flex items-center justify-center gap-3 py-2.5 rounded-lg bg-white text-slate-700 font-medium hover:bg-slate-100 transition shadow-lg">
      <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
      </svg>
      Sign in with Google
    </a>

    <p class="text-xs text-slate-500 mt-6 text-center">Access is limited to authorised @atlasuniversity.edu.in accounts.</p>
  </div>
</div>
